# Copiar como .env y configurar POSTGRES_PASSWORD con una clave local propia.
# start-compose.ps1 genera JWT_SECRET; start-compose-demo.ps1 genera también DEMO_PASSWORD.
# Por defecto Docker Compose utiliza el perfil registration, sin usuario demo inicial.
# Nunca subir .env al repositorio.
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL
# JWT_SECRET=
# DEMO_PASSWORD=
# MARKETLENS_PROFILE=registration
