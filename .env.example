# Copiar como .env y configurar POSTGRES_PASSWORD con una clave local propia.
# start-compose.ps1 genera JWT_SECRET; start-compose-demo.ps1 genera también DEMO_PASSWORD.
# Por defecto Docker Compose utiliza el perfil registration, sin usuario demo inicial.
# Nunca subir .env al repositorio.
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL
# JWT_SECRET=
# DEMO_PASSWORD=
# MARKETLENS_PROFILE=registration


# PRUEBA OPCIONAL OAuth centralizado (no activar en demo/registration).
# MARKETLENS_PROFILE=connected
# MELI_CLIENT_ID=APP_ID_DE_DEV_CENTER
# MELI_CLIENT_SECRET=CLIENT_SECRET_PRIVADO
# URL HTTPS exacta registrada en DevCenter, accesible al callback.
# MELI_REDIRECT_URI=https://ejemplo-seguro.invalid/api/integrations/mercadolibre/callback
# MELI_PKCE_ENABLED=true
# MELI_REVIEWS_CENTRAL_ENABLED=true
# Nombre de usuario EXISTENTE en MarketLens que autorizara la cuenta central.
# MELI_REVIEWS_CENTRAL_OWNER=usuario_operador
